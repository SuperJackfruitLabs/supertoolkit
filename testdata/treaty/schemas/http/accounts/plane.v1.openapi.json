{
  "openapi": "3.1.0",
  "info": {
    "title": "Accounts plane API",
    "version": "1",
    "description": "The Accounts routes other products call: the token exchanges, principals, grants, identities and the policy decision. Every refusal is `flat-error.v1`: `{ \"error\": \"<snake_code>\" }`, with `scope` beside an insufficient_scope and `usableAt` beside an identity_pending. Malformed JSON reads as an empty body and gets the route's body refusal. The sign-in flows (OAuth 2.1, OIDC discovery, the RFC 8628 device flow) are the standards, crossing accounts.sign-in; only Accounts' own body on the device flow's token endpoint is described here."
  },
  "x-treaty-error-envelope": "flat-error.v1",
  "servers": [
    {
      "url": "https://accounts.superjackfruit.com"
    }
  ],
  "paths": {
    "/api/token/service": {
      "post": {
        "operationId": "exchangeServiceToken",
        "summary": "A service's own access token for one audience",
        "description": "The caller's svc_ credential, exchanged for a token whose subject is the service itself (amr service). The service must be allowed the audience.",
        "security": [
          {
            "serviceCredential": []
          }
        ],
        "x-treaty-error-codes": [
          "invalid_credential",
          "invalid_target",
          "suspended",
          "not_permitted",
          "unknown_principal"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServiceTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Token"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidCredential"
          },
          "403": {
            "$ref": "#/components/responses/NotPermitted"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "423": {
            "$ref": "#/components/responses/Suspended"
          }
        }
      }
    },
    "/api/token/agent": {
      "post": {
        "operationId": "exchangeAgentToken",
        "summary": "An access token for an agent of the caller's workspace",
        "description": "The subject is the agent, `act.sub` the calling service (amr exchange). The grant must hold token:agent; a grant without it is not_permitted, not insufficient_scope. An agent of another workspace is not_permitted.",
        "security": [
          {
            "serviceCredential": ["token:agent"]
          }
        ],
        "x-treaty-error-codes": [
          "invalid_credential",
          "invalid_target",
          "suspended",
          "not_permitted",
          "unknown_principal"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Token"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidCredential"
          },
          "403": {
            "$ref": "#/components/responses/NotPermitted"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "423": {
            "$ref": "#/components/responses/Suspended"
          }
        }
      }
    },
    "/api/token/assertion": {
      "post": {
        "operationId": "exchangeAssertion",
        "summary": "An access token for a person acting from chat",
        "description": "Accounts resolves the person from a linked identity; a caller-supplied prn_ is never accepted. The token lives 120 seconds, carries no grant scope, and `act.sub` is the calling service (amr assertion). The grant must hold token:assert. A link the person made themselves is identity_pending until its hold is over.",
        "security": [
          {
            "serviceCredential": ["token:assert"]
          }
        ],
        "x-treaty-error-codes": [
          "invalid_credential",
          "suspended",
          "invalid_request",
          "invalid_target",
          "not_permitted",
          "unknown_identity",
          "not_human",
          "identity_pending",
          "unknown_principal"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssertionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Token"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidCredential"
          },
          "403": {
            "description": "Refused: not_permitted or identity_pending",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../common/flat-error.v1.json",
                  "description": "identity_pending says when the link starts to act as `usableAt`.",
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "error": {
                            "const": "identity_pending"
                          }
                        },
                        "required": ["error"]
                      },
                      "then": {
                        "required": ["usableAt"],
                        "properties": {
                          "usableAt": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "not_human: the identity is not a person's",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../common/flat-error.v1.json"
                }
              }
            }
          },
          "423": {
            "$ref": "#/components/responses/Suspended"
          }
        }
      }
    },
    "/api/token/device": {
      "post": {
        "operationId": "exchangeDeviceToken",
        "summary": "A person's access token from their device credential",
        "description": "The caller's dev_ credential, exchanged for a token whose subject is the person (amr device). It carries no grant scope. `org` picks another workspace the person belongs to; it defaults to the credential's.",
        "security": [
          {
            "deviceCredential": []
          }
        ],
        "x-treaty-error-codes": [
          "invalid_credential",
          "invalid_target",
          "suspended",
          "not_permitted",
          "unknown_principal"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Token"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidCredential"
          },
          "403": {
            "$ref": "#/components/responses/NotPermitted"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "423": {
            "$ref": "#/components/responses/Suspended"
          }
        }
      }
    },
    "/api/auth/device/token": {
      "post": {
        "operationId": "completeDeviceGrant",
        "summary": "The device flow's token endpoint, Accounts' success body",
        "description": "RFC 8628's device access token request. The request and its pending, slow-down and expiry answers are the standard (crossing accounts.sign-in) and are not described here. Accounts replaces the standard's successful token response with a device credential, `dev_<20 hex>:<43 base64url>`, minted for the workspace that was active when the sign-in was approved, and refuses with access_denied when none was.",
        "x-treaty-standard": "RFC 8628",
        "security": [],
        "x-treaty-error-codes": ["access_denied", "server_error"],
        "responses": {
          "200": {
            "description": "The device credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceCredential"
                }
              }
            }
          },
          "400": {
            "description": "access_denied: no workspace was active when the sign-in was approved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../common/flat-error.v1.json",
                  "properties": {
                    "error_description": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "server_error: the approved session was gone",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../common/flat-error.v1.json"
                }
              }
            }
          }
        }
      }
    },
