              }
            }
          },
          "423": {
            "$ref": "#/components/responses/Suspended"
          }
        }
      },
      "get": {
        "operationId": "listPrincipals",
        "summary": "Every principal of the caller's workspace, up to 500",
        "description": "Humans are the workspace's members. Sorted by kind, then handle.",
        "security": [
          {
            "serviceCredential": ["principals:read"]
          }
        ],
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["human", "agent", "service"]
            }
          }
        ],
        "x-treaty-error-codes": [
          "invalid_credential",
          "suspended",
          "insufficient_scope",
          "invalid_request"
        ],
        "responses": {
          "200": {
            "description": "The principals",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "maxItems": 500,
                  "items": {
                    "$ref": "#/components/schemas/Principal"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidCredential"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "423": {
            "$ref": "#/components/responses/Suspended"
          }
        }
      }
    },
