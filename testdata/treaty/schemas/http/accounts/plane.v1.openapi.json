    "/api/policy/decide": {
      "post": {
        "operationId": "decidePolicy",
        "summary": "May this agent take this work, under the workspace's dispatch policy",
        "description": "AuthZEN-shaped. No policy allows with `no-policy`, records nothing and returns null policyVersion and decisionId. Under a policy, a subject that is not an agent of the workspace is denied `unknown-subject`, a suspended one `suspended`, and every decision is recorded.",
        "security": [
          {
            "serviceCredential": ["policy:decide"]
          }
        ],
        "x-treaty-error-codes": [
          "invalid_credential",
          "suspended",
          "insufficient_scope",
          "invalid_request"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecideRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The decision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Decision"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidCredential"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "423": {
            "$ref": "#/components/responses/Suspended"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceCredential": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "svc_<20 hex>:<43 base64url>",
        "description": "A service credential, `Authorization: Bearer svc_<20 lowercase hex>:<43 base64url>`. The scopes listed on a route are the ones its grant must hold."
      },
      "deviceCredential": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "dev_<20 hex>:<43 base64url>",
        "description": "A person's device credential, `Authorization: Bearer dev_<20 lowercase hex>:<43 base64url>`, from the device flow."
      }
    },
    "responses": {
      "Token": {
        "description": "The access token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/TokenResponse"
            }
          }
        }
      },
      "BadRequest": {
        "description": "The body or query does not match the route",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../common/flat-error.v1.json"
            }
          }
        }
      },
      "InvalidCredential": {
        "description": "invalid_credential: no valid credential",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../common/flat-error.v1.json"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Refused: insufficient_scope, or the route's own refusal",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../common/flat-error.v1.json",
              "description": "insufficient_scope names the scope the route needs as `scope`.",
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "error": {
                        "const": "insufficient_scope"
                      }
                    },
                    "required": ["error"]
                  },
                  "then": {
                    "required": ["scope"],
                    "properties": {
                      "scope": {
                        "type": "string"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "NotPermitted": {
        "description": "not_permitted",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../common/flat-error.v1.json"
            }
          }
        }
      },
      "NotFound": {
        "description": "Not visible to the caller",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../common/flat-error.v1.json"
            }
          }
        }
      },
      "Suspended": {
        "description": "suspended: the caller or the principal it names is suspended",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../common/flat-error.v1.json"
            }
          }
        }
      }
    },
    "schemas": {
      "PrincipalId": {
        "type": "string",
        "pattern": "^prn_[0-9a-f]{20}$"
      },
      "OrgId": {
        "type": "string",
        "pattern": "^org_[0-9a-f]{20}$"
      },
      "Audience": {
        "type": "string",
        "description": "A registered audience, such as https://app.superpipeline.dev. Any other is invalid_target."
      },
      "LinkableSystem": {
        "type": "string",
        "enum": ["matrix", "superpipeline", "agentpod"]
      },
      "ServiceTokenRequest": {
        "type": "object",
        "required": ["audience"],
        "properties": {
          "audience": {
            "$ref": "#/components/schemas/Audience"
          }
        }
      },
      "AgentTokenRequest": {
        "type": "object",
        "required": ["principal", "audience"],
        "properties": {
          "principal": {
            "type": "string",
            "description": "The agent's prn_ id."
          },
          "audience": {
            "description": "One audience, or up to 8 distinct ones.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/Audience"
              },
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/components/schemas/Audience"
                }
              }
            ]
          }
        }
      },
      "AssertionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity", "audience"],
        "properties": {
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["system", "externalId"],
            "properties": {
              "system": {
                "$ref": "#/components/schemas/LinkableSystem"
              },
              "externalId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              }
            }
          },
          "audience": {
            "description": "One audience, or up to 8 distinct ones.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/Audience"
              },
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/components/schemas/Audience"
                }
              }
            ]
          }
        }
      },
      "DeviceTokenRequest": {
        "type": "object",
        "required": ["audience"],
        "properties": {
          "audience": {
            "$ref": "#/components/schemas/Audience"
          },
          "org": {
            "$ref": "#/components/schemas/OrgId"
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "required": ["access_token", "token_type", "expires_in"],
        "properties": {
          "access_token": {
            "type": "string",
            "minLength": 1,
            "description": "A signed JWT; its claims are crossing accounts.token-claims."
          },
          "token_type": {
            "const": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "minimum": 1,
            "description": "300, or 120 for an assertion."
          }
        }
      },
      "DeviceCredential": {
        "type": "object",
        "required": ["device_credential"],
        "properties": {
          "device_credential": {
            "type": "string",
            "pattern": "^dev_[0-9a-f]{20}:[A-Za-z0-9_-]{43}$"
          }
        }
      },
      "CreateAgentRequest": {
        "type": "object",
        "required": ["kind", "handle", "displayName"],
        "properties": {
          "kind": {
            "const": "agent"
          },
          "handle": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,31}$",
            "description": "Any other is invalid_handle."
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "\\S",
            "description": "Trimmed; blank is invalid_request."
          }
        }
      },
      "Created": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/PrincipalId"
          }
        }
      },
      "Ok": {
        "type": "object",
        "required": ["ok"],
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "Grant": {
        "type": "object",
        "required": ["mayDispatch", "mayGrantReach", "scopes"],
        "properties": {
          "mayDispatch": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PrincipalId"
            }
          },
          "mayGrantReach": {
            "type": "boolean"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Principal": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "handle",
          "displayName",
          "organizationId",
          "suspended",
          "grant"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/PrincipalId"
          },
          "kind": {
            "type": "string",
            "enum": ["human", "agent", "service"]
          },
          "handle": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "organizationId": {
            "$ref": "#/components/schemas/OrgId"
          },
          "suspended": {
            "type": "boolean"
          },
          "role": {
            "type": "string",
            "enum": ["owner", "admin", "member"],
            "description": "A person's role in the caller's workspace; absent for agents and services."
          },
          "grant": {
            "$ref": "#/components/schemas/Grant"
          }
        }
      },
      "GrantRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mayDispatch", "mayGrantReach"],
        "properties": {
          "mayDispatch": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PrincipalId"
            },
            "description": "Agents of the workspace; anything else is invalid_grant."
          },
          "mayGrantReach": {
            "type": "boolean"
          },
          "scopes": {
            "type": "array",
            "description": "Absent keeps the stored scopes. A malformed scope is invalid_grant.",
            "items": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9._-]*(:[a-z0-9._*-]+)*$"
            }
          }
        }
      },
      "IdentityRequest": {
        "type": "object",
        "required": ["externalId"],
        "properties": {
          "externalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        }
      },
      "Identity": {
        "type": "object",
        "required": ["system", "externalId"],
        "properties": {
          "system": {
            "type": "string"
          },
          "externalId": {
            "type": "string"
          }
        }
      },
      "ResolvedIdentity": {
        "type": "object",
        "required": ["principalId", "kind", "suspended"],
        "properties": {
          "principalId": {
            "$ref": "#/components/schemas/PrincipalId"
          },
          "kind": {
            "type": "string",
            "enum": ["human", "agent", "service"]
          },
          "suspended": {
            "type": "boolean"
          }
        }
      },
      "DecideRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "action", "resource"],
        "properties": {
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "The agent's prn_ id."
          },
          "action": {
            "const": "take"
          },
          "resource": {
            "type": "object",
            "additionalProperties": false,
            "required": ["board", "stage"],
            "properties": {
              "board": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "stage": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "labels": {
                "type": "array",
                "maxItems": 50,
                "default": [],
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "capabilities": {
                "type": "array",
                "maxItems": 50,
                "default": [],
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "card": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      },
      "Decision": {
        "type": "object",
        "required": [
          "allow",
          "reasons",
          "policyVersion",
          "limits",
          "decisionId"
        ],
        "properties": {
          "allow": {
            "type": "boolean"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "`allowed`, `no-policy`, `unknown-subject`, `suspended`, `policy-error`, or the ids of the rules that forbade it."
          },
          "policyVersion": {
            "type": ["integer", "null"]
          },
          "limits": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "maxRuns", "windowHours"],
              "properties": {
                "id": {
                  "type": "string"
                },
                "maxRuns": {
                  "type": "integer"
                },
                "windowHours": {
                  "type": "integer"
                }
              }
            }
          },
          "decisionId": {
            "type": ["string", "null"],
            "pattern": "^pdc_[0-9a-f]{20}$"
          }
        }
      }
    }
  }
}
