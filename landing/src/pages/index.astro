---
/**
 * supertoolkit.dev — the public page.
 *
 * One page, no framework; the suite frame (@superjackfruit/frontdoor) owns the header, footer and
 * theme toggle. Its job is to explain the product to somebody who typed the domain, and then send
 * them to the docs or the source. There is nothing to sign in to: SuperToolkit runs on the reader's
 * own machine, so the page sells nothing it cannot hand over.
 *
 * This directory is deliberately outside the Go module and has its own npm lockfile.
 * `go build ./...` never looks in here.
 *
 * Every string in the hero is real.
 *   stk:ref:github:v1   broker.Placeholder (internal/broker/proxy.go)
 *   GH_TOKEN            the github entry's EnvVar (internal/catalog/catalog.go)
 * The service list is read from internal/catalog/catalog.go at build time, so the page cannot name
 * a service the catalogue does not have. The operations are catalog.Auth's cases and their
 * Reassurance() text; the four MCP tools are internal/mcp's; the limits are docs/limitations.md;
 * the installer is install.sh, copied into public/ at build time. If any of those change, this
 * page is wrong.
 *
 * Colours and faces are listed once in `:root` below. SuperToolkit's colour is vibekit's indigo
 * (PRODUCT_ACCENTS: indigo, OKLCH hue 277), its Daylight tokens for light and dark, read from the
 * package at build time (src/accent.ts). The suite frame keeps its own SuperToolkit colour (#5b5fe0)
 * for its bar and header. Indigo is spent on three things only: the placeholder, the one invariant,
 * and the approval.
 */
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import ShareMeta from '../components/ShareMeta.astro';
import { productAccent } from '../accent';
import SuiteHead from '@superjackfruit/frontdoor/components/SuiteHead.astro';
import Frame from '@superjackfruit/frontdoor/components/Frame.astro';

const SITE = 'https://supertoolkit.dev';
const DOCS = 'https://docs.supertoolkit.dev';
const REPO = 'https://github.com/SuperJackfruitLabs/supertoolkit';
const FORGE = 'https://forge.superjackfruit.com/SuperJackfruitLabs/supertoolkit';
// vibekit's indigo: --indigo is the accent as text (accent-text, the page sets it at body size),
// --indigo-strong the accent itself (the button, the rules), --indigo-tint its pale ground and
// --indigo-ink text on the accent. The light set also answers the system when nothing is chosen.
const { light: AL, dark: AD } = productAccent('supertoolkit');
const vars = (t: typeof AL) => `--indigo: ${t.text}; --indigo-strong: ${t.accent}; --indigo-tint: ${t.wash}; --indigo-ink: ${t.fg};`;
const ACCENT_CSS = `:root { ${vars(AD)} }
:root[data-theme='light'] { ${vars(AL)} }
@media (prefers-color-scheme: light) { :root:not([data-theme='dark']) { ${vars(AL)} } }`;
const TITLE = 'SuperToolkit — the agent never holds the credential';
const DESCRIPTION =
  'A credential broker for agents. The agent asks for an effect by name; the broker substitutes, signs or mints on the wire. Runs on your own machine. Apache-2.0.';

// The catalogue's services, read from the Go source at build time (the build runs in landing/).
const catalog = readFileSync(resolve(process.cwd(), '../internal/catalog/catalog.go'), 'utf8');
const SERVICES = [...catalog.matchAll(/Name:\s+"([a-z0-9-]+)",\s*Host:/g)].map((m) => m[1]);
if (SERVICES.length < 10) throw new Error(`landing: read only ${SERVICES.length} services from internal/catalog/catalog.go`);
const has = (s: string) => {
  if (!SERVICES.includes(s)) throw new Error(`landing: the catalogue has no ${s}`);
  return s;
};

// Structured data for search and agents; every value is one the page already states.
const JSON_LD = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'SuperToolkit',
  description: DESCRIPTION,
  url: SITE,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, macOS',
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  sameAs: [REPO, FORGE],
  publisher: { '@type': 'Organization', name: 'Super Jackfruit Labs', url: 'https://superjackfruit.com' },
};

// The credential operations, from catalog.Auth and Reassurance(). Four of them never put a
// long-lived secret on the API's wire, which is the point of having more than one.
const operations = [
  { name: 'substitute', what: 'A stored token replaces the placeholder on the wire.', wire: 'long-lived', services: ['github', 'slack', 'notion', 'openai', 'cloudflare', 'resend'].map(has).join(' · ') },
  { name: 'substitute, scheme-aware', what: 'Decode the Basic header, replace the value, re-encode. A plain string swap matches nothing here.', wire: 'long-lived', services: has('stripe') },
  { name: 'sign', what: 'The request is signed inside the broker with SigV4. The credential is an HMAC over the request, not a value anything can carry.', wire: 'never', services: has('aws-sts') },
  { name: 'mint', what: 'A JWT is minted from a stored private key and exchanged for an installation token that expires in an hour.', wire: 'never', services: has('github-app') },
  { name: 'refresh', what: 'A stored OAuth 2.0 refresh token is exchanged for a short-lived access token. The refresh token only ever reaches the provider’s token endpoint.', wire: 'never', services: [has('x'), has('google')].join(' · ') },
  { name: 'exchange', what: 'A stored service credential is exchanged at the organization plane for a token that lasts minutes. The credential only ever reaches the exchange endpoint.', wire: 'never', services: [has('superpipeline-approvals-read'), has('superpipeline-approvals-write')].join(' · ') },
];

// From docs/limitations.md. The warning label stays on.
const limits = [
  ['A client that ignores proxy configuration goes around the broker', 'It fails silently, sending the placeholder to the provider and getting a plausible 401. Nothing inside a proxy can detect a client that never speaks to it, so `stk doctor --probe` detects it from outside.'],
  ['Brokered mTLS does not work', '502, loud, nothing sent. The broker holds no client certificate. Tunnel that host instead.'],
  ['WebSocket and other upgrades are refused', 'A credential is substituted on an HTTP request, and an upgraded connection carries no further requests to substitute into. 501, with the way out.'],
  ['On Linux the store key is a file beside the ciphertext', 'There is usually no OS keychain, so a credential on a server is less well protected than the same one on a laptop. `doctor` warns; `STK_PASSPHRASE` from your init system avoids it.'],
];

const INSTALL = `curl -fsSL ${SITE}/install.sh | sh`;
const code = (s: string) => s.replace(/`([^`]+)`/g, '<code>$1</code>');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <meta name="theme-color" content="#0d1017" />
    <SuiteHead product="supertoolkit" />
    <ShareMeta title={TITLE} description={DESCRIPTION} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(JSON_LD)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />
    <style is:inline set:html={ACCENT_CSS}></style>
    <style is:global>
      /* The suite's bones: Plex Sans and Plex Mono, a dark-first surface stack, and one display
         face of the product's own, Outfit, the geometric sans the wordmark is drawn in.
         Contrast (WCAG 2.x), with vibekit 0.0.15's Daylight indigo:
           dark   indigo text #838ee7 on #0d1017 6.3:1, on surface 5.9:1, on its tint 4.6:1 ·
                  button text #17162a on #7f8ae7 5.7:1 · muted #8b95a6 on surface 5.8:1
           light  indigo text #5a62be on #f8f9fa 5.1:1, on #eef1f4 4.7:1, on its tint 4.7:1 ·
                  button text #fff8ee on #5f67c9 4.7:1 · muted #5c6678 on white 5.8:1
         The indigo tokens come from vibekit (ACCENT_CSS above); only the grounds are this page's. */
      :root {
        --bg: #0d1017; --surface: #141923; --inset: #070a0f; --line: rgba(255,255,255,.08);
        --text: #e9edf3; --muted: #8b95a6; --code: #c9d1dc;
        --warn: #f4a526; --warn-tint: rgba(244,165,38,.14);
        --sans: 'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif;
        --mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
        --display: 'Outfit', var(--sans);
        --measure: 64rem;
        color-scheme: dark light;
      }
      /* Light tokens: chosen by the frame's toggle (data-theme="light"), or by the system when
         the visitor has not chosen. */
      :root[data-theme='light'] {
        --bg: #f8f9fa; --surface: #ffffff; --inset: #eef1f4; --line: rgba(32,40,61,.12);
        --text: #171c26; --muted: #5c6678; --code: #2b3242;
        --warn: #8a5a06; --warn-tint: rgba(244,165,38,.18);
        color-scheme: light;
      }
      :root[data-theme='dark'] { color-scheme: dark; }
      @media (prefers-color-scheme: light) {
        :root:not([data-theme='dark']) {
          --bg: #f8f9fa; --surface: #ffffff; --inset: #eef1f4; --line: rgba(32,40,61,.12);
          --text: #171c26; --muted: #5c6678; --code: #2b3242;
          --warn: #8a5a06; --warn-tint: rgba(244,165,38,.18);
          color-scheme: light;
        }
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
      body {
        margin: 0; background: var(--bg); color: var(--text);
        font-family: var(--sans); font-size: 16px; line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; }
      a:focus-visible { outline: 2px solid var(--indigo); outline-offset: 3px; border-radius: 4px; }
      code, pre, .mono { font-family: var(--mono); }
      h1, h2, h3 { font-family: var(--display); font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin: 0; }
      .wrap { max-width: var(--measure); margin: 0 auto; padding: 0 20px; }
      .band { border-top: 1px solid var(--line); padding: 72px 0; }
      .band h2 { font-size: clamp(1.4rem, 3.4vw, 2rem); margin-bottom: 10px; }
      .lede { color: var(--muted); max-width: 46rem; }
      .em { color: var(--indigo); font-style: normal; }
    </style>
  </head>

  <body>
    <Frame product="supertoolkit" cta={{ label: 'Install', href: `${DOCS}/install/` }}>
    <main>
      <section class="wrap hero">
        <p class="kicker mono">credential broker for agents</p>
        <h1>The agent never holds <em class="em">the credential</em>.</h1>
        <p class="lede big">
          An agent asks for an effect by name. The broker substitutes, signs or mints on the
          wire, where the agent cannot reach. If it reads its own token, it has read nothing.
        </p>

        <!-- The substitution, which is the whole product in one picture. Both strings are real. -->
        <div class="swap" role="img" aria-label="The child process holds a placeholder; the provider receives the real credential.">
          <div class="swap-side">
            <p class="swap-label mono">what the agent sees</p>
            <pre class="box"><code>GH_TOKEN=<span class="em">stk:ref:github:v1</span></code></pre>
            <p class="swap-note">Worthless off this host.</p>
          </div>
          <div class="swap-mid" aria-hidden="true">
            <span class="mono">broker</span>
            <div class="arrow"></div>
          </div>
          <div class="swap-side">
            <p class="swap-label mono">what GitHub receives</p>
            <pre class="box"><code>Authorization: Bearer <span class="redacted">ghp_••••••••••••</span></code></pre>
            <p class="swap-note">Substituted on the wire. Never in the agent’s reach.</p>
          </div>
        </div>

        <div class="cta">
          <a class="button" href={`${DOCS}/install/`}>Install</a>
          <a class="button ghost" href={DOCS}>Read the docs</a>
        </div>
        <p class="sub mono">Apache-2.0 · runs on your machine · no account, no telemetry</p>
      </section>

      <section class="band" aria-labelledby="p">
        <div class="wrap">
          <h2 id="p">The usual way puts the key in the agent’s context</h2>
          <p class="lede">
            To give an agent a tool you put an API key in an MCP config file. That file is
            plaintext, any process can read it, and the agent reads it to start the server,
            so the credential lands in the agent’s own context, and from there in the
            transcript and wherever transcripts are kept.
          </p>
          <p class="lede">
            SuperToolkit holds the credential in a process the agent cannot read, and puts it
            on the wire on the way out. Clients need no modification: they are started with
            <code>HTTPS_PROXY</code> pointing at the broker and a placeholder where their
            token would be.
          </p>
        </div>
      </section>

      <section class="band" aria-labelledby="o">
        <div class="wrap">
          <h2 id="o">Six operations, and four never send a lasting secret</h2>
          <p class="lede">
            What a service needs decides what the broker does. The catalogue declares it, so
            a new scheme is an entry rather than a branch in the request path. It has
            {SERVICES.length} services today, and a git forge or a third-party MCP server can be
            declared in your own configuration.
          </p>
          <ul class="ops">
            {operations.map((o) => (
              <li>
                <div class="op-head">
                  <span class="op-name mono">{o.name}</span>
                  <span class={o.wire === 'never' ? 'pill good' : 'pill warn'}>
                    {o.wire === 'never' ? 'no long-lived secret on the wire' : 'long-lived on the wire'}
                  </span>
                </div>
                <p>{o.what}</p>
                <p class="op-svc mono">{o.services}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="band" aria-labelledby="a">
        <div class="wrap">
          <h2 id="a">A read is the agent’s. A write is <em class="em">yours</em>.</h2>
          <p class="lede">
            Policy is one file you commit, holding no secrets. Defaults come from the
            catalogue and fail safe: a read is agent-callable, a write needs approval, and
            anything unclassified is treated as a write. Approvals wait for you locally, in
            <code>stk approvals</code> or <code>stk ui</code>, or, if you name a board, on
            SuperPipeline, where a workspace owner or admin decides.
          </p>
          <div class="two">
            <pre class="box"><code>{`services:
  github:
    capabilities:
      create_issue: approval
profiles:
  reader:
    github: [get_user, list_repos]`}</code></pre>
            <div class="card">
              <p class="card-head mono">waiting on you</p>
              <p class="card-what mono">github / create_issue</p>
              <p class="card-args mono">title=“Flaky test in the broker”</p>
              <p class="card-foot">
                The agent is told <code>pending</code> and nothing happens. Approving performs
                it and records what came back; refusing performs nothing. Expiry is never
                approval.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="band" aria-labelledby="m">
        <div class="wrap">
          <h2 id="m">From an agent, four tools</h2>
          <p class="lede">
            <code>stk mcp</code> speaks MCP on stdio with exactly four tools (categories,
            actions, details, execute), so a hundred services cost four tool definitions of
            context instead of a thousand. <code>stk mcp install claude</code> prints the
            client config, with no secret in it.
          </p>
          <p class="lede">
            A third-party MCP server can be served under its own tool names with
            <code>stk mcp serve</code>: every call is decided by policy and recorded before the
            server sees it, and the server’s own network goes through the broker, decided by
            address after the name is resolved.
          </p>
        </div>
      </section>

      <section class="band" aria-labelledby="r">
        <div class="wrap">
          <h2 id="r">Afterwards, a record that answers the question</h2>
          <p class="lede">
            What was done, under which policy, and what the provider said. What is recorded
            about the credential is a fingerprint, or the name of the operation that replaced
            it: never the value, and there is a test for every scheme.
          </p>
          <pre class="box wide"><code>{`$ stk audit
  Oct 15 02:20:28  github     create_issue             approval 201 Created
                   POST /repos/you/your-repo/issues · credential: sha256:40a7a1d2319d
  Oct 15 02:20:15  github     get_user                 agent    200 OK
                   GET /user · credential: sha256:40a7a1d2319d`}</code></pre>
        </div>
      </section>

      <section class="band" aria-labelledby="l">
        <div class="wrap">
          <h2 id="l">What it does not do</h2>
          <p class="lede">
            Read this before trusting it with something that matters. Each of these is a
            decision or a measurement, not an oversight.
          </p>
          <dl class="limits">
            {limits.map(([head, body]) => (
              <div>
                <dt>{head}</dt>
                <dd set:html={code(body)} />
              </div>
            ))}
          </dl>
          <p class="lede">
            The full list, with what each would cost to change, is on
            <a href={`${DOCS}/limitations/`}>the limitations page</a>.
          </p>
        </div>
      </section>

      <section class="band" aria-labelledby="g">
        <div class="wrap">
          <h2 id="g">Have a look</h2>
          <p class="lede">
            It runs on your own machine, on Linux and macOS. There is no account, nothing
            phones home, and the only hosts it contacts are the providers you connect. The
            installer checks the release against its <code>SHA256SUMS</code> and refuses rather
            than warns.
          </p>
          <pre class="box wide"><code>{`${INSTALL}

stk init
stk add github && stk connect github
stk doctor --probe        # prove your clients go through the broker
stk run -- your-agent`}</code></pre>
          <p class="lede after">
            Or build it from source with Go: the <a href={`${DOCS}/install/`}>install page</a> has
            both. The source is on <a href={REPO}>GitHub</a> and on the <a href={FORGE}>forge</a>.
          </p>
        </div>
      </section>
    </main>
    </Frame>

    <style>
      .hero { padding-top: 56px; padding-bottom: 80px; }
      .kicker { color: var(--indigo); font-size: .8rem; letter-spacing: .08em; text-transform: uppercase; margin: 0 0 18px; }
      h1 { font-size: clamp(2.1rem, 6.4vw, 3.6rem); max-width: 18ch; }
      .big { font-size: 1.12rem; margin: 20px 0 0; }
      .sub { color: var(--muted); font-size: .85rem; margin-top: 20px; }
      .after { margin-top: 16px; }
      .after a, .lede a { color: var(--indigo); text-underline-offset: 3px; }

      .swap { display: grid; grid-template-columns: 1fr auto 1fr; gap: 18px; align-items: center; margin-top: 40px; }
      .swap-side { min-width: 0; }
      .swap-label { color: var(--muted); font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; margin: 0 0 8px; }
      .swap-note { color: var(--muted); font-size: .85rem; margin: 10px 0 0; }
      .swap-mid { display: grid; justify-items: center; gap: 6px; color: var(--muted); font-size: .72rem; }
      .arrow { width: 46px; height: 2px; background: linear-gradient(90deg, var(--indigo-strong), var(--indigo)); position: relative; }
      .arrow::after { content: ''; position: absolute; right: -1px; top: -4px; border: 5px solid transparent; border-left-color: var(--indigo); }
      .redacted { color: var(--muted); }
      @media (max-width: 760px) {
        .swap { grid-template-columns: 1fr; }
        .swap-mid { justify-items: start; }
        .arrow { transform: rotate(90deg); margin-left: 18px; }
      }

      .box { background: var(--inset); border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; margin: 0; overflow-x: auto; font-size: .88rem; color: var(--code); line-height: 1.6; }
      .box.wide { margin-top: 24px; }

      .ops { list-style: none; padding: 0; margin: 28px 0 0; display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
      .ops li { background: var(--surface); padding: 20px 22px; }
      .ops p { margin: 8px 0 0; color: var(--muted); max-width: 54rem; }
      .op-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
      .op-name { color: var(--text); font-weight: 500; }
      .op-svc { font-size: .78rem; color: var(--muted); opacity: .85; overflow-wrap: anywhere; }
      .pill { font-family: var(--mono); font-size: .68rem; padding: 3px 9px; border-radius: 999px; white-space: nowrap; }
      .pill.good { background: var(--indigo-tint); color: var(--indigo); }
      .pill.warn { background: var(--warn-tint); color: var(--warn); }

      .two { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 28px; align-items: start; }
      @media (max-width: 760px) { .two { grid-template-columns: 1fr; } }
      .card { background: var(--surface); border: 1px solid var(--line); border-left: 3px solid var(--indigo-strong); border-radius: 10px; padding: 18px 20px; }
      .card-head { color: var(--indigo); font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; margin: 0 0 12px; }
      .card-what { margin: 0; font-weight: 500; }
      .card-args { margin: 4px 0 0; color: var(--muted); font-size: .85rem; }
      .card-foot { margin: 14px 0 0; color: var(--muted); font-size: .9rem; }

      .limits { margin: 28px 0 24px; display: grid; gap: 18px; }
      .limits dt { font-weight: 600; }
      .limits dd { margin: 6px 0 0; color: var(--muted); max-width: 54rem; }
      .limits :global(code), .lede code, .card-foot code { background: var(--inset); border: 1px solid var(--line); border-radius: 5px; padding: 1px 5px; font-size: .86em; }

      .cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 36px; }
      .button { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; font-weight: 600; font-size: .95rem; padding: 0 20px; border-radius: 9px; background: var(--indigo-strong); color: var(--indigo-ink); border: 1px solid transparent; }
      .button.ghost { background: transparent; color: var(--text); border-color: var(--line); }
      .button:hover { filter: brightness(1.08); }
    </style>
  </body>
</html>
