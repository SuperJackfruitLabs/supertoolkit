// supertoolkit.dev: a Worker with static assets and no script.
//
// A Worker rather than a Pages project because the custom domain can be declared
// here, so `wrangler deploy` attaches it — the same shape the other product sites
// use. Deployed by scripts/deploy-sites.sh with the operator's own `wrangler
// login`; no API token is created or stored.
{
  "name": "supertoolkit-landing",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "supertoolkit.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
